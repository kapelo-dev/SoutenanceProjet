---
config:
  theme: neutral
  flowchart:
    curve: linear
    nodeSpacing: 45
    rankSpacing: 60
---
flowchart TB

    subgraph TERRAIN["Postes clients"]
        direction LR
        PHONE["Smartphone agent PDV<br/><i>Android 8+</i><br/>———————<br/>APK PDV Connect v2.9<br/>SQLite / Room<br/>DataStore (token)"]
        BROWSER["Poste superviseur<br/><i>Navigateur</i><br/>———————<br/>Blade + Tailwind<br/>Alpine.js"]
    end

    OPERATEUR["Réseau opérateur<br/>YAS / Mixx &amp; FLOOZ<br/>———————<br/>SMS transactionnels"]

    subgraph VPS1["VPS 1 — Application (Docker Engine)"]
        direction TB
        subgraph NET1["Réseau bridge : pdvconnect"]
            direction TB
            APP["Conteneur pdvconnect-app<br/><i>PHP 8.3 / Apache</i><br/>———————<br/>Laravel 12<br/>API REST + Web<br/>Port 80"]
            SCHED["Conteneur pdvconnect-scheduler<br/><i>RUN_MODE=scheduler</i><br/>———————<br/>Cron Laravel<br/>backup:database 02h00"]
            DB[("Conteneur pdvconnect-mysql<br/><i>MySQL 8.0</i><br/>———————<br/>Port 3306<br/>utf8mb4")]
            VOLDB[/"Volume mysql_data"/]
            VOLAPP[/"Volumes app_storage<br/>app_logs<br/>public/downloads (APK)"/]
        end
    end

    subgraph VPS2["VPS 2 — Sauvegardes (Docker Engine)"]
        direction TB
        subgraph NET2["Réseau bridge : minio"]
            MINIO["Conteneur pdvconnect-minio<br/><i>MinIO — API S3</i><br/>———————<br/>Port 9000 (API)<br/>Port 9001 (console)"]
            VOLMIN[/"Volume minio_data<br/>bucket pdvconnect-backups"/]
        end
    end

    OPERATEUR -. "SMS (GSM)" .-> PHONE
    PHONE -- "HTTPS / REST + Bearer token<br/>POST /api/transactions/from-sms<br/>POST /api/mobile/agent/login" --> APP
    BROWSER -- "HTTPS<br/>session + RBAC" --> APP

    APP -- "TCP 3306<br/>Eloquent / PDO" --> DB
    SCHED -- "TCP 3306<br/>mysqldump" --> DB
    DB --- VOLDB
    APP --- VOLAPP

    SCHED == "HTTP S3 port 9000<br/>upload du dump<br/>(pare-feu : IP VPS 1 uniquement)" ==> MINIO
    MINIO --- VOLMIN

    classDef client fill:#eef4ff,stroke:#3b6fd4,stroke-width:1px,color:#12305e
    classDef srv fill:#eafaf0,stroke:#28a463,stroke-width:1px,color:#0d4527
    classDef store fill:#fff6e5,stroke:#d99b1b,stroke-width:1px,color:#5c3d00
    classDef ext fill:#fdeaea,stroke:#d0454c,stroke-width:1px,color:#5e1416

    class PHONE,BROWSER client
    class APP,SCHED,MINIO srv
    class DB,VOLDB,VOLAPP,VOLMIN store
    class OPERATEUR ext
